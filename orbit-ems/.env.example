# Local-only values. Never commit .env or copy production credentials here.
# The app's managed OAuth/runtime keys are supplied by Manus in a managed project.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/DATABASE?sslaccept=strict"
# Managed object-storage helper consumes these at runtime; use authorized project values.
MANUS_API_URL="https://api.example.invalid"
MANUS_API_KEY="replace-with-authorized-local-value"
