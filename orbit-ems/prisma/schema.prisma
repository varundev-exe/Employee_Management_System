generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(80)
  code      String     @unique @db.VarChar(20)
  color     String     @default("#6759E8") @db.VarChar(20)
  manager   String?    @db.VarChar(120)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  employees Employee[]

  @@map("ems_departments")
}

model Employee {
  id               Int                @id @default(autoincrement())
  employeeCode     String             @unique @db.VarChar(24)
  userId           Int?               @unique
  firstName        String             @db.VarChar(80)
  lastName         String             @db.VarChar(80)
  email            String             @unique @db.VarChar(320)
  phone            String?            @db.VarChar(40)
  jobTitle         String             @db.VarChar(120)
  departmentId     Int?
  manager          String?            @db.VarChar(120)
  location         String?            @db.VarChar(100)
  status           String             @default("Active") @db.VarChar(24)
  employmentType   String             @default("Full-time") @db.VarChar(24)
  hireDate         DateTime           @db.Date
  salary           Decimal            @default(0) @db.Decimal(12, 2)
  avatarUrl        String?            @db.VarChar(500)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  department       Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  payroll          Payroll[]
  performance      PerformanceReview[]
  goals            Goal[]
  documents        DocumentRecord[]

  @@index([departmentId, status])
  @@map("ems_employees")
}

model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  workDate    DateTime  @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      String    @default("Present") @db.VarChar(24)
  note        String?   @db.VarChar(300)
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, workDate])
  @@index([workDate, status])
  @@map("ems_attendance")
}

model LeaveRequest {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  type        String    @db.VarChar(40)
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  days        Decimal   @db.Decimal(5, 1)
  reason      String    @db.VarChar(1000)
  status      String    @default("Pending") @db.VarChar(24)
  reviewer    String?   @db.VarChar(120)
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status, startDate])
  @@map("ems_leave_requests")
}

model LeaveBalance {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  year        Int
  type        String    @db.VarChar(40)
  entitled    Decimal   @default(20) @db.Decimal(5, 1)
  used        Decimal   @default(0) @db.Decimal(5, 1)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, type])
  @@map("ems_leave_balances")
}

model Payroll {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  periodStart  DateTime  @db.Date
  periodEnd    DateTime  @db.Date
  baseSalary   Decimal   @db.Decimal(12, 2)
  deductions   Decimal   @default(0) @db.Decimal(12, 2)
  netPay       Decimal   @db.Decimal(12, 2)
  status       String    @default("Draft") @db.VarChar(24)
  createdAt    DateTime  @default(now())
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodEnd])
  @@index([periodEnd, status])
  @@map("ems_payroll")
}

model PerformanceReview {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  reviewer    String    @db.VarChar(120)
  rating      Decimal   @db.Decimal(3, 1)
  summary     String    @db.VarChar(1200)
  period      String    @db.VarChar(40)
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@map("ems_performance_reviews")
}

model Goal {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  title        String    @db.VarChar(180)
  description  String?   @db.VarChar(1000)
  progress     Int       @default(0)
  dueDate      DateTime? @db.Date
  status       String    @default("In progress") @db.VarChar(24)
  createdAt    DateTime  @default(now())
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
  @@map("ems_goals")
}

model DocumentRecord {
  id               Int        @id @default(autoincrement())
  employeeId       Int?
  uploadedByUserId Int
  fileName         String     @db.VarChar(240)
  mimeType         String     @db.VarChar(120)
  byteSize         Int
  objectKey        String     @unique @db.VarChar(700)
  category         String     @default("document") @db.VarChar(40)
  createdAt        DateTime   @default(now())
  deletedAt        DateTime?
  employee         Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId, deletedAt])
  @@index([uploadedByUserId, createdAt])
  @@map("ems_documents")
}

model Activity {
  id          Int       @id @default(autoincrement())
  actorUserId Int?
  actorName   String    @db.VarChar(120)
  action      String    @db.VarChar(80)
  entity      String    @db.VarChar(80)
  entityId    Int?
  detail      String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@map("ems_activity")
}
